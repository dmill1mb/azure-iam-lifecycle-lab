# Copy to terraform.tfvars (gitignored) and fill in real values.

location              = "southcentralus"
resource_group_name   = "rg-iamlab"
admin_username        = "labadmin"
allowed_rdp_source_ip = "203.0.113.10" # yours: Invoke-RestMethod https://api.ipify.org
vm_size               = "Standard_D2_v4"

# admin_password is NOT set here. Per terminal:
#   see the README (Read-Host -AsSecureString), never a plaintext value in a file.